---
import { siteConfig } from "../config";

// Artwork images: fixed positions and different sizes
const artworks = [
  { src: "/images/1.png", x: 8, y: 16, width: 191 },
  { src: "/images/2.png", x: 23, y: 13, width: 200 },
  { src: "/images/3.png", x: 43, y: 16, width: 319 },
  { src: "/images/4.png", x: 64, y: 17, width: 246 },
  { src: "/images/5.png", x: 87, y: 15, width: 200 },
  { src: "/images/6.png", x: 13, y: 37, width: 282 },
  { src: "/images/7.png", x: 34, y: 40, width: 209 },
  { src: "/images/8.png", x: 57, y: 37, width: 309 },
  { src: "/images/9.png", x: 82, y: 36, width: 228 },
  { src: "/images/10.png", x: 9, y: 70, width: 319 },
  { src: "/images/11.png", x: 29, y: 65, width: 400 },
  { src: "/images/12.png", x: 49, y: 62, width: 246 },
  { src: "/images/13.png", x: 71, y: 64, width: 237 },
  { src: "/images/14.png", x: 91, y: 65, width: 309 },
  { src: "/images/15.png", x: 23, y: 85, width: 264 },
  { src: "/images/16.png", x: 77, y: 85, width: 291 },
  { src: "/images/17.jpg", x: 53, y: 83, width: 260 },
];
---

<div
  id="hero"
  class="relative isolate overflow-hidden bg-white min-h-[650px] md:h-screen"
  style={`--accent-color: ${siteConfig.accentColor}`}
>
  <!-- Artwork background -->
  <div class="artwork-background" aria-hidden="true">
    {
      artworks.map((artwork, index) => (
        <img
          src={`${import.meta.env.BASE_URL.replace(/\/$/, "")}${artwork.src}`}
          alt=""
          class="artwork-image"
          data-artwork-index={index}
          loading="eager"
          decoding="async"
          style={`
            --x: ${artwork.x}%;
            --y: ${artwork.y}%;
            --width: ${artwork.width}px;
          `}
        />
      ))
    }
  </div>

  <!-- White overlay for text readability -->
  <div class="hero-overlay"></div>

  <!-- Hero content -->
  <div
    class="relative z-10 h-full mx-auto p-8 sm:p-12 md:p-24 flex items-center"
  >
    <div class="hero-content">
      <h2
        class="text-pretty text-xl sm:text-2xl md:text-5xl font-bold tracking-tight text-gray-700 animate-fade-in"
      >
        Hello! 👋
      </h2>

      <h1
        class="mt-6 sm:mt-8 md:mt-10 text-pretty text-4xl sm:text-5xl md:text-6xl lg:text-8xl font-bold tracking-tight text-gray-800 animate-fade-in animation-delay-200"
      >
        I'm
        <span style={`color: ${siteConfig.accentColor}`}>
          {siteConfig.name}
        </span>
      </h1>

      <p
        class="mt-4 sm:mt-6 md:mt-8 text-pretty text-base sm:text-lg md:text-xl/8 font-medium text-gray-600 animate-fade-in animation-delay-400"
      >
        {siteConfig.title}
      </p>
    </div>
  </div>

  <!-- Social links -->
  <div
    class="absolute z-20 bottom-0 left-0 right-0 p-8 sm:p-12 md:p-24 flex gap-x-4 sm:gap-x-6 md:gap-x-8 text-gray-700 animate-fade-in animation-delay-600"
  >
    {
      siteConfig.social?.email && (
        <a
          href={`mailto:${siteConfig.social.email}`}
          aria-label="Email"
          class="transition-colors duration-300 hover:text-[var(--accent-color)]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-6 w-6 sm:h-7 sm:w-7 md:h-8 md:w-8"
          >
            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
            <path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z" />
            <path d="M3 7l9 6l9 -6" />
          </svg>
        </a>
      )
    }

    {
      siteConfig.social?.linkedin && (
        <a
          href={siteConfig.social.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
          class="transition-colors duration-300 hover:text-[var(--accent-color)]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-6 w-6 sm:h-7 sm:w-7 md:h-8 md:w-8"
          >
            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
            <path d="M8 11v5" />
            <path d="M8 8v.01" />
            <path d="M12 16v-5" />
            <path d="M16 16v-3a2 2 0 1 0 -4 0" />
            <path d="M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4z" />
          </svg>
        </a>
      )
    }

    {
      siteConfig.social?.twitter && (
        <a
          href={siteConfig.social.twitter}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Twitter"
          class="transition-colors duration-300 hover:text-[var(--accent-color)]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-6 w-6 sm:h-7 sm:w-7 md:h-8 md:w-8"
          >
            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
            <path d="M4 4l11.733 16h4.267l-11.733 -16z" />
            <path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772" />
          </svg>
        </a>
      )
    }

    {
      siteConfig.social?.github && (
        <a
          href={siteConfig.social.github}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
          class="transition-colors duration-300 hover:text-[var(--accent-color)]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-6 w-6 sm:h-7 sm:w-7 md:h-8 md:w-8"
          >
            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
            <path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5" />
          </svg>
        </a>
      )
    }
  </div>
</div>

<script>
  function initializeArtworkAnimation() {
    const hero = document.querySelector("#hero");
    if (!hero) return;

    const images = Array.from(
      hero.querySelectorAll<HTMLElement>(".artwork-image")
    );

    if (images.length === 0) return;

    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    );

    if (reducedMotion.matches) return;

    const activeCount = Math.min(5, images.length);
    const activeIndices = new Set<number>();

    // Select a random image that is not already active
    function getRandomInactiveIndex(): number | null {
      const available = images
        .map((_, index) => index)
        .filter((index) => !activeIndices.has(index));

      if (available.length === 0) return null;

      return available[Math.floor(Math.random() * available.length)];
    }

    // Activate one image
    function activateImage() {
      const index = getRandomInactiveIndex();

      if (index === null) return;

      activeIndices.add(index);
      images[index].classList.add("active");

      // Fade out after a short duration
      const visibleDuration = 1200 + Math.random() * 700;

      window.setTimeout(() => {
        images[index].classList.remove("active");
        activeIndices.delete(index);

        // Small pause before activating another image
        window.setTimeout(activateImage, 250);
      }, visibleDuration);
    }

    // Start 5 independent animation cycles
    for (let i = 0; i < activeCount; i++) {
      window.setTimeout(() => {
        activateImage();
      }, i * 200);
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener(
      "DOMContentLoaded",
      initializeArtworkAnimation,
      { once: true }
    );
  } else {
    initializeArtworkAnimation();
  }
</script>

<style>
  /* ========================= */
  /* Artwork Background */
  /* ========================= */

  .artwork-background {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .artwork-image {
    position: absolute;

    left: var(--x);
    top: var(--y);

    width: var(--width);
    height: auto;

    max-height: 40%;

    object-fit: contain;

    transform: translate(-50%, -50%);

    /* Default appearance */
    opacity: 0.35;
    filter: blur(2px);

    /* Faster transitions */
    transition:
      opacity 0.65s ease-in-out,
      filter 0.65s ease-in-out;

    will-change: opacity, filter;
  }

  .artwork-image.active {
    opacity: 1;
    filter: blur(0);
  }

  /* Subtle overlay */
  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;

    pointer-events: none;

    background: linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.42) 0%,
      rgba(255, 255, 255, 0.3) 45%,
      rgba(255, 255, 255, 0.08) 100%
    );
  }

  .hero-content {
    position: relative;
    z-index: 10;

    max-width: 800px;
  }

  /* ========================= */
  /* Mobile adjustments */
  /* ========================= */

  @media (max-width: 768px) {
    .artwork-image {
      width: calc(var(--width) * 0.65);
      max-height: 20%;
      opacity: 0.09;
      filter: blur(3px);
    }

    .artwork-image.active {
      opacity: 0.65;
      filter: blur(0);
    }

    .hero-overlay {
      position: absolute;
      inset: 0;
      z-index: 1;
      pointer-events: none;

      background: linear-gradient(
        90deg,
        rgba(255, 255, 255, 0.25) 0%,
        rgba(255, 255, 255, 0.15) 45%,
        rgba(255, 255, 255, 0.05) 100%
      );
    }

  /* ========================= */
  /* Hero text animation */
  /* ========================= */

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in {
    animation: fadeIn 0.8s ease-out forwards;
    opacity: 0;
  }

  .animation-delay-200 {
    animation-delay: 0.2s;
  }

  .animation-delay-400 {
    animation-delay: 0.4s;
  }

  .animation-delay-600 {
    animation-delay: 0.6s;
  }

  @media (max-width: 768px) {
    .artwork-image {
      width: calc(var(--width) * 0.65);
      max-height: 25%;
      opacity: 0.25;
      filter: blur(2px);
    }

    .artwork-image.active {
      opacity: 0.85;
      filter: blur(0);
    }

    .hero-overlay {
      background: rgba(255, 255, 255, 0.2);
    }
  }
</style>