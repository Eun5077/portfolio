---
import { siteConfig } from "../config";

const hasProjects =
  siteConfig.projects && siteConfig.projects.length > 0;
---

{
  hasProjects && (
    <section
      id="projects"
      class="p-8 sm:p-12 md:p-16 lg:p-24"
      style={`--project-accent: ${siteConfig.accentColor}`}
    >
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">

        {/* Section Title */}
        <div class="lg:col-span-4">
          <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-gray-900">
            Projects
          </h2>

          <div
            class="w-[75px] h-[5px] mt-2 rounded-full"
            style={`background-color: ${siteConfig.accentColor}`}
          />
        </div>

        {/* Project Cards */}
        <div class="lg:col-span-8">
          <div class="space-y-8">

            {siteConfig.projects.map((project, index) => (

              <div class="group relative">

                <div class="project-card relative overflow-hidden p-4 sm:p-6 md:p-8 bg-gray-50 rounded-xl sm:rounded-2xl border border-gray-200 transition-all duration-300 hover:bg-white hover:shadow-xl hover:border-gray-300 hover:-translate-y-1">

                  {/* Background Image */}
                  {project.image && (
                    <div class="project-image-container">
                      <img
                        src={`${import.meta.env.BASE_URL.replace(/\/$/, "")}${project.image}`}
                        alt=""
                        class="project-image"
                        loading="lazy"
                      />
                    </div>
                  )}

                  {/* Project Content */}
                  <div class="relative z-10">

                    {/* Number & Date */}
                    <div class="flex items-center justify-between mb-3">
                      <span
                        class="text-sm font-mono"
                        style={`color: ${siteConfig.accentColor}`}
                      >
                        {String(index + 1).padStart(2, "0")}
                      </span>

                      {project.date && (
                        <span class="text-sm text-gray-500 font-medium">
                          {project.date}
                        </span>
                      )}
                    </div>

                    {/* Title */}
                    <h3 class="text-xl sm:text-2xl font-bold text-gray-900 mb-4">
                      {project.name}
                    </h3>

                    {/* Description */}
                    <p class="text-base sm:text-lg text-gray-700 leading-relaxed mb-5">
                      {project.description}
                    </p>

                    {/* Skills */}
                    {project.skills && project.skills.length > 0 && (
                      <div class="flex flex-wrap gap-1.5 sm:gap-2 mb-6">
                        {project.skills.map((skill) => (
                          <span class="px-2.5 sm:px-3 py-1 sm:py-1.5 bg-gray-900 text-white rounded-md sm:rounded-lg text-xs sm:text-sm font-medium">
                            {skill}
                          </span>
                        ))}
                      </div>
                    )}

                    {/* Links */}
                    <div class="flex flex-wrap gap-3 sm:gap-4 pt-4 border-t border-gray-200">

                      {project.github && (
                        <a
                          href={project.github}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="project-link"
                        >
                          GitHub ↗
                        </a>
                      )}

                      {project.website && (
                        <a
                          href={project.website}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="project-link"
                        >
                          Website ↗
                        </a>
                      )}

                      {project.demo && (
                        <a
                          href={project.demo}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="project-link"
                        >
                          Demo ↗
                        </a>
                      )}

                      {project.paper && (
                        <a
                          href={project.paper}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="project-link"
                        >
                          Project Paper ↗
                        </a>
                      )}

                    </div>

                  </div>
                </div>
              </div>

            ))}

          </div>
        </div>
      </div>
    </section>
  )
}

<style>
  /* Project card */
  .project-card {
    min-height: 260px;
  }

  /* Background image positioning */
  .project-image-container {
    position: absolute;
    top: 50%;
    right: 8%;

    width: 55%;
    height: 85%;

    transform: translateY(-50%);

    display: flex;
    align-items: center;
    justify-content: flex-end;

    pointer-events: none;
    z-index: 0;
  }

  .project-image {
    width: 100%;
    height: 100%;

    object-fit: contain;
    object-position: right center;

    opacity: 0.25;

    transition:
      opacity 0.5s ease,
      transform 0.5s ease;
  }

  /* Hover effect */
  .project-card:hover .project-image {
    opacity: 0.45;
    transform: scale(1.05);
  }

  /* Links */
  .project-link {
    display: inline-flex;
    align-items: center;

    font-size: 0.875rem;
    font-weight: 600;

    color: #374151;

    padding: 0.5rem 0.75rem;

    border: 1px solid #d1d5db;
    border-radius: 0.5rem;

    background: rgba(255, 255, 255, 0.9);

    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .project-link:hover {
    color: var(--project-accent);
    border-color: var(--project-accent);
  }

  /* Mobile */
  @media (max-width: 768px) {
    .project-image-container {
      width: 65%;
      height: 65%;
      right: -5%;
    }

    .project-image {
      opacity: 0.12;
    }

    .project-card:hover .project-image {
      opacity: 0.7;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card,
    .project-image,
    .project-link {
      transition: none;
    }
  }
</style>