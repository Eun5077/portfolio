---
import { siteConfig } from "../config";

const hasCompositions =
  siteConfig.compositions && siteConfig.compositions.length > 0;
---

{
  hasCompositions && (
    <section
      id="compositions"
      class="p-8 sm:p-12 md:p-16 lg:p-24"
      style={`--composition-accent: ${siteConfig.accentColor}`}
    >
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">

        {/* Section Title */}
        <div class="lg:col-span-4">
          <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-gray-900">
            Compositions
          </h2>

          <div
            class="w-[75px] h-[5px] mt-2 rounded-full"
            style={`background-color: ${siteConfig.accentColor}`}
          />
        </div>

        {/* Composition Cards */}
        <div class="lg:col-span-8">
          <div class="space-y-8">

            {siteConfig.compositions.map((composition, index) => (

              <div class="group relative">

                <div class="composition-card relative overflow-hidden p-4 sm:p-6 md:p-8 bg-gray-50 rounded-xl sm:rounded-2xl border border-gray-200 transition-all duration-300 hover:bg-white hover:shadow-xl hover:border-gray-300 hover:-translate-y-1">

                  {/* Background Image */}
                  {composition.image && (
                    <div class="composition-image-container">
                      <img
                        src={`${import.meta.env.BASE_URL.replace(/\/$/, "")}${composition.image}`}
                        alt=""
                        class="composition-image"
                        loading="lazy"
                      />
                    </div>
                  )}

                  {/* Content */}
                  <div class="relative z-10">

                    {/* Number & Year */}
                    <div class="flex items-center justify-between mb-3">

                      <span
                        class="text-sm font-mono"
                        style={`color: ${siteConfig.accentColor}`}
                      >
                        {String(index + 1).padStart(2, "0")}
                      </span>

                      <span class="text-sm text-gray-500 font-medium">
                        {composition.year}
                      </span>

                    </div>

                    {/* Composition Title */}
                    <h3 class="text-xl sm:text-2xl font-bold text-gray-900 mb-2">
                      {composition.name}
                    </h3>

                    {/* Instrumentation */}
                    <p class="text-base sm:text-lg font-medium text-gray-700 mb-2">
                      {composition.instrumentation}
                    </p>

                    {/* Duration */}
                    {composition.duration && (
                      <p class="text-sm text-gray-500 mb-4">
                        Duration: {composition.duration}
                      </p>
                    )}

                    {/* Description */}
                    {composition.description && (
                      <p class="text-base sm:text-lg text-gray-700 leading-relaxed mb-5">
                        {composition.description}
                      </p>
                    )}

                    {/* Links */}
                    <div class="flex flex-wrap gap-3 sm:gap-4 pt-4 border-t border-gray-200">

                      {composition.recording && (
                        <a
                          href={composition.recording}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="composition-link"
                        >
                          Recording ↗
                        </a>
                      )}

                      {composition.score && (
                        <a
                          href={composition.score}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="composition-link"
                        >
                          Score ↗
                        </a>
                      )}

                      {composition.video && (
                        <a
                          href={composition.video}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="composition-link"
                        >
                          Video ↗
                        </a>
                      )}
                      {composition.website && (
                        <a
                            href={composition.website}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="composition-link"
                        >
                            Website ↗
                        </a>
                        )}

                        {composition.paper && (
                        <a
                            href={composition.paper}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="composition-link"
                        >
                            Project Paper ↗
                        </a>
                        )}

                    </div>

                  </div>

                </div>
              </div>

            ))}

          </div>
        </div>

      </div>
    </section>
  )
}

<style>
  .composition-card {
    min-height: 260px;
  }

  /* Right-side image */
  .composition-image-container {
    position: absolute;
    top: 50%;
    right: 8%;

    width: 55%;
    height: 85%;

    transform: translateY(-50%);

    display: flex;
    align-items: center;
    justify-content: flex-end;

    pointer-events: none;
    z-index: 0;
  }

  .composition-image {
    width: 100%;
    height: 100%;

    object-fit: contain;
    object-position: right center;

    opacity: 0.25;

    transition:
      opacity 0.5s ease,
      transform 0.5s ease;
  }

  .composition-card:hover .composition-image {
    opacity: 0.45;
    transform: scale(1.05);
  }

  /* Links */
  .composition-link {
    display: inline-flex;
    align-items: center;

    font-size: 0.875rem;
    font-weight: 600;

    color: #374151;

    padding: 0.5rem 0.75rem;

    border: 1px solid #d1d5db;
    border-radius: 0.5rem;

    background: rgba(255, 255, 255, 0.9);

    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .composition-link:hover {
    color: var(--composition-accent);
    border-color: var(--composition-accent);
  }

  /* Mobile */
  @media (max-width: 768px) {
    .composition-image-container {
      width: 65%;
      height: 65%;
      right: 5%;
    }

    .composition-image {
      opacity: 0.12;
    }

    .composition-card:hover .composition-image {
      opacity: 0.2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .composition-card,
    .composition-image,
    .composition-link {
      transition: none;
    }
  }
</style>